# Copy to .env and fill in from Supabase: Project Settings -> API
# The anon key is safe to expose in the browser; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, for testing "Check my CV" against a local copy of CV Analyzer LK (npm run dev in that repo).
# Leave it out to use the live site.
# VITE_CV_ANALYZER_URL=http://localhost:3000
